{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camp-explorer-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Canonical origin used at build time for SEO metadata (canonicals, sitemap,
  // robots, OG URLs, JSON-LD). Apex is canonical; www serves the same Worker.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://campexplorersa.com"
  },
  // Incremental cache for OpenNext (prerendered/ISR pages) — see open-next.config.ts.
  // Serves cached renders instead of re-rendering every request (cuts CPU per request).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "1dc925613ad8485f9da93c7a714f3ad9"
    }
  ],
  // Keep the workers.dev URL alive as a permanent staging/preview URL
  // (camp-explorer-website.tanya-topacharova.workers.dev)
  "workers_dev": true,
  // Production custom domains. Apex + www point to the same Worker; the
  // test subdomain is retained as a permanent staging URL.
  "routes": [
    { "pattern": "campexplorersa.com", "custom_domain": true },
    { "pattern": "www.campexplorersa.com", "custom_domain": true },
    { "pattern": "test.campexplorersa.com", "custom_domain": true }
  ]
}
